// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  nickname     String   @unique
  passwordHash String
  currency     Int      @default(100)
  seedCount    Int      @default(1)
  seedInventory Json    @default("{\"CARROT\":1,\"STRAWBERRY\":0,\"TOMATO\":0,\"SUNFLOWER\":0}")
  produceInventory Json @default("{\"CARROT\":0,\"STRAWBERRY\":0,\"TOMATO\":0,\"SUNFLOWER\":0}")
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 자리를 비운 사이 정원에 일어난 변화를 모아뒀다가 "정원 소식" 모달로 한 번 보여주고 비운다.
  pendingGrownCount Int       @default(0)
  pendingWeedCount  Int       @default(0)
  pendingSummaryFrom DateTime?

  cageItems     CageItem[]
  gardenPlots   GardenPlot[]
  missions      Mission[]
  behaviorLogs  BehaviorLog[]
  hamster       Hamster?
}

enum HamsterAppearance {
  GOLDEN
  GRAY
}

enum HamsterState {
  IDLE
  SLEEPING
}

model Hamster {
  id          String            @id @default(cuid())
  userId      String            @unique
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  appearance  HamsterAppearance
  personality String            @default("느긋함")
  hunger      Int               @default(80)
  thirst      Int               @default(80)
  cleanliness Int               @default(80)
  mood        Int               @default(80)
  stamina     Int               @default(80)
  intimacy    Int               @default(0)
  growthStage String            @default("BABY")
  state       HamsterState      @default(IDLE)
  displayScale Float            @default(1)
  // 케이지를 보는 동안 스스로 하는 행동(모래목욕, 쳇바퀴 등)의 마지막 시각. 연속 요청을 막는 쿨다운 기준.
  lastIdleAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

enum ItemId {
  FOOD_BOWL
  WATER_BOTTLE
  HANDHELD_WATER_BOTTLE
  WATER_BOWL
  HOUSE
  WHEEL
  SAND_BATH
  SNACK_DISH
  LOOKOUT
}

// 정적 참조 카탈로그. 5종 고정, seed.ts로 채운다.
model ItemMaster {
  id          ItemId  @id
  name        String
  cost        Int
  purchasable Boolean @default(true)
  effectJson  Json?

  cageItems CageItem[]
}

model CageItem {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemMasterId ItemId
  itemMaster   ItemMaster @relation(fields: [itemMasterId], references: [id])
  posX         Float      @default(0.5)
  posY         Float      @default(0.5)
  scale        Float      @default(1)
  flipped      Boolean    @default(false)
  isPlaced     Boolean    @default(true)
  createdAt    DateTime   @default(now())

  @@unique([userId, itemMasterId])
}

enum PlotStatus {
  EMPTY
  GROWING
  READY
}

enum CropId {
  CARROT
  STRAWBERRY
  TOMATO
  SUNFLOWER
}

model GardenPlot {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  plotIndex Int
  cropId    CropId?
  status    PlotStatus @default(EMPTY)
  hasWeed   Boolean    @default(false)
  plantedAt DateTime?
  lastWateredAt       DateTime?
  lastWateredEffectAt DateTime?
  waterBoostCount     Int       @default(0)
  // 다음 잡초가 자랄 시점을 재는 기준. 심을 때와 잡초를 뽑을 때 갱신한다.
  weedFrom  DateTime?

  @@unique([userId, plotIndex])
}

enum MissionId {
  FEED
  WATER
  PET
  GARDEN
}

model Mission {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionType  MissionId
  missionDate  String
  progress     Int       @default(0)
  target       Int
  refreshedAt  DateTime  @default(now())
  completedAt  DateTime?

  @@unique([userId, missionType, missionDate])
}

enum HamsterBehavior {
  IDLE
  WALK
  LOOK
  EAT
  DRINK
  SLEEP
  WHEEL
  PET
  WASH
  CHEEK
  USER_LOOK
  GARDEN
}

model BehaviorLog {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  behaviorType      HamsterBehavior
  firstDiscoveredAt DateTime        @default(now())

  @@unique([userId, behaviorType])
}
