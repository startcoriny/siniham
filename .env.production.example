# 운영 서버용 환경변수 템플릿.
# 이 파일을 서버에서 .env로 복사한 뒤 값을 채운다. 채운 .env는 절대 커밋하지 않는다.
#
#   cp .env.production.example .env
#
# 개발용 .env의 값을 그대로 가져다 쓰지 않는다. 로컬 값은 이미 여러 곳에 노출돼 있다.

# ── 도메인과 인증서 ────────────────────────────────────────────────
# DOMAIN의 A 레코드가 이 서버의 공인 IP를 가리켜야 Let's Encrypt 발급이 된다.
DOMAIN=example.com
ACME_EMAIL=you@example.com

# ── 데이터베이스 ──────────────────────────────────────────────────
# 비밀번호는 아래 명령으로 새로 만든다. URL에 들어가므로 @ : / ? # 는 피한다.
#   openssl rand -hex 32
POSTGRES_USER=siniham
POSTGRES_PASSWORD=
POSTGRES_DB=siniham

# ── 인증 ────────────────────────────────────────────────────────
# 이 값이 새면 누구나 아무 계정의 로그인 토큰을 위조할 수 있다. 반드시 새로 만든다.
#   openssl rand -base64 48
JWT_SECRET=

# 참고. DATABASE_URL은 docker-compose.prod.yml이 위 세 값으로 직접 조립하므로
# 여기에 따로 두지 않는다. POSTGRES_PORT도 운영에서는 DB를 외부에 열지 않아 필요 없다.
